# Environment Variables Template

# Supabase Configuration
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# n8n Webhook (optional — for triggering n8n workflows from admin panel)
# Create a Webhook trigger node in n8n and paste the URL here
# VITE_N8N_WEBHOOK_URL=https://your-n8n.cloud/webhook/your-webhook-id

# Optional: API Keys for external services
# VITE_ANALYTICS_KEY=your-analytics-key
# VITE_EMAIL_SERVICE_KEY=your-email-service-key
